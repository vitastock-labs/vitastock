{
	"name": "@vitastock/backend",
	"type": "module",
	"private": true,
	"files": [
		".output",
		"dist"
	],
	"engines": {
		"node": "24.x.x"
	},
	"scripts": {
		"build": "tsdown",
		"build:nitro": "vite build",
		"compile": "bun build --compile --minify --sourcemap --bytecode ./src/server.ts --outfile server",
		"dev": "cross-env NODE_ENV=development pnpm dev:watch",
		"dev:docker-postgres-redis": "docker compose up vitastock-postgres-db vitastock-redis-cache vitastock-redis-queue",
		"dev:nitro": "vite dev",
		"dev:nitro:prod": "cross-env NODE_ENV=production vite dev",
		"dev:prod": "cross-env NODE_ENV=production pnpm dev:watch",
		"dev:staging": "cross-env NODE_ENV=staging pnpm dev:watch",
		"dev:watch": "tsx watch src/server.ts --clear-screen=false",
		"dev:worker": "cross-env NODE_ENV=development PROCESS_TYPE=worker tsx watch src/worker.ts --clear-screen=false",
		"lint:eslint": "eslint . --max-warnings=0",
		"lint:format": "prettier --write .",
		"lint:type-check": "tsc --pretty -p tsconfig.json",
		"maintenance:keepalive:services": "tsx scripts/keepServicesAlive.ts",
		"maintenance:keepalive:db": "tsx scripts/keepDatabaseAlive.ts",
		"preview:nitro": "vite preview",
		"start": "cross-env NODE_ENV=production tsx src/server.ts",
		"start:built": "cross-env NODE_ENV=production node dist/server.js",
		"start:built:nitro": "cross-env NODE_ENV=production node .output/server/index.mjs",
		"start:built:staging": "cross-env NODE_ENV=staging node dist/server.js",
		"start:built:staging:nitro": "cross-env NODE_ENV=staging node .output/server/index.mjs",
		"start:dev": "cross-env NODE_ENV=development tsx src/server.ts",
		"start:worker": "cross-env NODE_ENV=production PROCESS_TYPE=worker tsx src/worker.ts",
		"start:worker:built": "cross-env NODE_ENV=production PROCESS_TYPE=worker node dist/worker.js",
		"start:worker:built:staging": "cross-env NODE_ENV=staging PROCESS_TYPE=worker node dist/worker.js",
		"test": "vitest run",
		"test:integration": "cross-env NODE_ENV=development LOG_LEVEL=silent vitest run --config vitest.integration.config.ts",
		"test:watch": "vitest"
	},
	"dependencies": {
		"@bull-board/api": "^9.13.1",
		"@bull-board/hono": "^9.13.1",
		"@colors/colors": "^1.6.1",
		"@date-fns/tz": "^1.5.0",
		"@getbrevo/brevo": "^6.2.0",
		"@hono/node-server": "2.1.8",
		"@node-rs/argon2": "^2.2.2",
		"@vitastock/db": "workspace:*",
		"@vitastock/env": "workspace:*",
		"@vitastock/shared": "workspace:*",
		"@vitastock/transactional": "workspace:*",
		"@zayne-labs/callapi": "1.16.3",
		"@zayne-labs/toolkit-core": "0.13.2",
		"@zayne-labs/toolkit-type-helpers": "0.13.2",
		"@zayne-labs/tsconfig": "^0.14.0",
		"bullmq": "^6.7.6",
		"consola": "3.4.2",
		"croner": "^11.0.0",
		"cross-env": "^10.1.0",
		"date-fns": "4.4.0",
		"drizzle-orm": "0.45.4",
		"hono": "4.13.18",
		"hono-pino": "^0.10.3",
		"hono-rate-limiter": "^0.5.4",
		"ioredis": "^6.0.0",
		"jsonwebtoken": "^9.0.3",
		"nodemailer": "^10.5.0",
		"papaparse": "^5.7.1",
		"pino": "^10.4.0",
		"pino-pretty": "^13.2.0",
		"redis": "^6.3.1",
		"superjson": "^2.2.6",
		"tsx": "4.23.15",
		"zod": "4.6.7"
	},
	"devDependencies": {
		"@total-typescript/ts-reset": "0.6.1",
		"@types/jsonwebtoken": "^9.0.10",
		"@types/node": "26.6.6",
		"@types/nodemailer": "^8.0.2",
		"@types/papaparse": "^5.5.2",
		"nitro": "3.0.261103-rc",
		"tsdown": "0.23.7",
		"typescript": "6.0.3",
		"vite": "^8.3.8",
		"vitest": "^5.1.0"
	}
}
