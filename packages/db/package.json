{
	"name": "@vitastock/db",
	"type": "module",
	"private": true,
	"exports": {
		".": "./src/db.ts",
		"./constants": "./src/constants.ts",
		"./schema/*": "./src/schema/*.ts"
	},
	"engines": {
		"node": "24.x.x"
	},
	"scripts": {
		"build": "tsdown",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "cross-env DB_MIGRATING=true drizzle-kit migrate",
		"db:push": "drizzle-kit push",
		"db:push-seed": "pnpm db:push && pnpm db:seed",
		"db:push-seed:staging": "cross-env NODE_ENV=staging pnpm db:push-seed",
		"db:push:prod": "cross-env NODE_ENV=production pnpm db:push",
		"db:push:staging": "cross-env NODE_ENV=staging pnpm db:push",
		"db:seed": "cross-env DB_SEEDING=true tsx src/seed.ts",
		"db:studio": "drizzle-kit studio",
		"dev": "tsx watch src/db.ts",
		"lint:eslint": "eslint . --max-warnings 0",
		"lint:format": "prettier --write .",
		"lint:type-check": "tsc --pretty -p tsconfig.json"
	},
	"dependencies": {
		"@faker-js/faker": "^10.6.0",
		"@node-rs/argon2": "^2.2.1",
		"@vitastock/env": "workspace:*",
		"@zayne-labs/toolkit-type-helpers": "^0.12.59",
		"@zayne-labs/tsconfig": "0.13.19",
		"consola": "3.4.2",
		"cross-env": "^10.1.0",
		"date-fns": "4.4.0",
		"drizzle-kit": "0.31.11",
		"drizzle-orm": "0.45.3",
		"drizzle-zod": "^0.8.3",
		"pg": "8.23.0",
		"tsx": "4.23.15",
		"zod": "4.6.5"
	},
	"devDependencies": {
		"@total-typescript/ts-reset": "0.6.1",
		"@types/pg": "8.23.1",
		"tsdown": "0.23.0",
		"typescript": "6.0.3"
	}
}
